      "name": "01 Успешные запросы",
      "item": [
        {
          "name": "01 — Все поля заполнены",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"uid\": \"1\",\n  \"operationUid\": \"operation-1\",\n  \"systemTime\": \"2026-10-06T10:00:00.000Z\",\n  \"communicationId\": 1,\n  \"systemName\": \"ERP\",\n  \"source\": \"Postman\",\n  \"templateId\": 1,\n  \"productCode\": 2,\n  \"smsCode\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/feedback",
            "description": "Ожидается HTTP 200, code = success, errorCode = пустая строка."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test(\"code\", function () { pm.expect(body.code).to.eql(\"success\"); });",
                  "pm.test(\"errorCode\", function () { pm.expect(body.errorCode).to.eql(\"\"); });",
                  "pm.test(\"Нет ошибок\", function () { pm.expect(body.errorMessage).to.eql(\"\"); });",
                  "pm.test(\"uid в ответе\", function () { pm.expect(body.uid).to.eql(\"1\"); pm.expect(body).not.to.have.property(\"uuid\"); });"
                ]
              }
            }
          ],
          "response": []
        },
